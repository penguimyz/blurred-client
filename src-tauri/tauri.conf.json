{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blurred Client",
  "version": "0.1.0",
  "identifier": "dev.blurredclient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blurred Client",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A Minecraft launcher with Lunar-grade polish and Prism-grade control.",
    "longDescription": "Blurred Client is a Minecraft launcher: manage instances, mod loaders (Fabric/Quilt), Modrinth mods and modpacks, and Microsoft accounts, with per-instance Java and JVM settings.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdbus-1-3",
          "xdg-utils"
        ]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "dbus-libs", "xdg-utils"]
      }
    }
  }
}
